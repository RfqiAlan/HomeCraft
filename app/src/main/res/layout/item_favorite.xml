<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Left Image -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_favorite_product"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_placeholder" />
    </androidx.cardview.widget.CardView>

    <!-- Product Title -->
    <TextView
        android:id="@+id/tv_favorite_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="Coffee Table"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_favorite"
        app:layout_constraintStart_toEndOf="@id/cv_image"
        app:layout_constraintTop_toTopOf="@id/cv_image" />

    <!-- Product Price -->
    <TextView
        android:id="@+id/tv_favorite_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="$ 50.00"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_favorite"
        app:layout_constraintStart_toEndOf="@id/cv_image"
        app:layout_constraintTop_toBottomOf="@id/tv_favorite_name" />

    <!-- Remove Button (X) -->
    <ImageButton
        android:id="@+id/btn_remove_favorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cv_image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_to_cart_item"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:backgroundTint="?attr/colorSurfaceVariant"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_cart"
            app:iconTint="?android:attr/textColorPrimary"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:iconPadding="0dp"
            style="@style/Widget.MaterialComponents.Button"
        app:layout_constraintBottom_toBottomOf="@id/cv_image"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider Line -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/cv_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
