<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Urutkan Produk"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_sort_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_price_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:buttonTint="#1A1A1A"
            android:text="Harga: Terendah ke Tertinggi"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rb_price_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:buttonTint="#1A1A1A"
            android:text="Harga: Tertinggi ke Terendah"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rb_rating_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:buttonTint="#1A1A1A"
            android:text="Rating: Tertinggi"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rb_rating_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#1A1A1A"
            android:text="Rating: Terendah"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply_sort"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Terapkan"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1A1A1A"
        app:cornerRadius="28dp"
        app:elevation="0dp"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
