<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.SettingsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <!-- Hero Header Background -->
            <View
                android:id="@+id/header_bg"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_profile_header"/>
                
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp" />

            <!-- Unauthenticated Layout -->
            <LinearLayout
                android:id="@+id/layout_unauthenticated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_title"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginTop="60dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to HomeCraft"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Log in to view your profile, track your orders, and save your favorites."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:textAlignment="center" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login_profile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="24dp"
                    app:backgroundTint="#212121"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:text="LOG IN"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Authenticated Layout -->
            <LinearLayout
                android:id="@+id/layout_authenticated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@id/tv_title"
                android:layout_marginTop="20dp"
                android:visibility="visible">
                
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp">
                    
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_avatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@color/white">
                        <ImageView
                            android:id="@+id/img_profile_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_person"
                            app:tint="#BDBDBD"
                            android:scaleType="centerInside"
                            android:padding="16dp"/>
                    </androidx.cardview.widget.CardView>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/cv_avatar"
                        android:layout_marginStart="16dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">
                        
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tv_user_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="User Name"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_badge_gold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_user_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="user@email.com"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp" />
                    </LinearLayout>
                </RelativeLayout>
                
                <!-- Settings List -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Settings"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <!-- Shipping Address -->
                        <RelativeLayout
                            android:id="@+id/layout_shipping_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground">
                            
                            <ImageView
                                android:id="@+id/ic_shipping"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_map_pin"
                                app:tint="?android:attr/textColorPrimary"
                                android:layout_centerVertical="true"/>
                                
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/ic_shipping"
                                android:layout_toStartOf="@id/img_edit_address"
                                android:layout_marginStart="16dp"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:id="@+id/tv_shipping_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shipping Address"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="16sp"/>
                                <TextView
                                    android:id="@+id/tv_current_address"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="No address set"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/img_edit_address"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?android:attr/textColorSecondary"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_color" android:layout_marginHorizontal="16dp"/>
                        
                        <!-- Language -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">
                            
                            <ImageView
                                android:id="@+id/ic_lang"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_language"
                                app:tint="?android:attr/textColorPrimary"
                                android:layout_centerVertical="true"/>
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/ic_lang"
                                android:layout_marginStart="16dp"
                                android:text="@string/language_label"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:layout_centerVertical="true"/>

                            <RadioGroup
                                android:id="@+id/rg_language"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">
                                <RadioButton
                                    android:id="@+id/rb_lang_en"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_payment_method_option"
                                    android:button="@null"
                                    android:text="EN"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textStyle="bold"
                                    android:paddingHorizontal="16dp"
                                    android:layout_marginEnd="8dp" />
                                <RadioButton
                                    android:id="@+id/rb_lang_id"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_payment_method_option"
                                    android:button="@null"
                                    android:text="ID"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textStyle="bold"
                                    android:paddingHorizontal="16dp" />
                            </RadioGroup>
                        </RelativeLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_color" android:layout_marginHorizontal="16dp"/>
                        
                        <!-- Dark Mode -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">
                            
                            <ImageView
                                android:id="@+id/ic_dark"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_dark_mode"
                                app:tint="?android:attr/textColorPrimary"
                                android:layout_centerVertical="true"/>
                                
                            <TextView
                                android:id="@+id/tv_theme_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/ic_dark"
                                android:layout_marginStart="16dp"
                                android:text="Dark Mode"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:layout_centerVertical="true"/>

                            <Switch
                                android:id="@+id/switch_dark_mode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:theme="@style/Widget.AppCompat.CompoundButton.Switch"/>
                        </RelativeLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="32dp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#E53935"
                    app:strokeWidth="1dp"
                    android:text="LOGOUT"
                    android:textColor="#E53935"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                    
                <!-- App Version -->
                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HomeCraft v1.0.0"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="40dp" />

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
