<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clipToPadding="false">

    <!-- Shimmer Image Placeholder -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_image_shimmer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/shimmer_bg"
        app:layout_constraintDimensionRatio="H,1:1.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shimmer Title Placeholder -->
    <View
        android:id="@+id/tv_product_name_shimmer"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="32dp"
        android:background="@color/shimmer_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_image_shimmer" />

    <!-- Shimmer Price Placeholder -->
    <View
        android:id="@+id/tv_product_price_shimmer"
        android:layout_width="60dp"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:background="@color/shimmer_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_product_name_shimmer" />

</androidx.constraintlayout.widget.ConstraintLayout>
